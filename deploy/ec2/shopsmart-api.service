[Unit]
Description=ShopSmart Express API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=shopsmart
Group=shopsmart
WorkingDirectory=/opt/shopsmart/app/backend
# Server-only settings (DATABASE_URL, optional GEMINI_API_KEY). File is root:shopsmart 0640, never committed.
EnvironmentFile=/etc/shopsmart/api.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
